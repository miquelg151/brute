[
  {
    "name": "setup",
    "helper": true,
    "steps": [
      { "save": null },
      { "click": "text=Start" },
      { "click": ".create-next" },
      { "click": ".create-next" },
      { "click": ".create-next" },
      { "eval": "const input = document.querySelector('.name-input'); input.value = 'Miquel'; input.dispatchEvent(new Event('input'));" },
      { "click": "text=Create fighter" }
    ]
  },
  {
    "name": "level-10",
    "helper": true,
    "steps": [
      { "include": "setup" },
      { "eval": "const s = JSON.parse(localStorage.getItem('brute.save')); s.character.level = 10; s.character.xp = 9; localStorage.setItem('brute.save', JSON.stringify(s)); location.reload();" },
      { "wait": 1500 }
    ]
  },
  {
    "name": "no-page-scroll",
    "helper": true,
    "steps": [
      { "eval": "const d = document.documentElement; if (d.scrollHeight > innerHeight || d.scrollWidth > innerWidth) throw new Error(`the page scrolls: ${d.scrollWidth}x${d.scrollHeight} in ${innerWidth}x${innerHeight}`);" }
    ]
  },
  {
    "name": "no-step-scroll",
    "helper": true,
    "steps": [
      { "eval": "const b = document.querySelector('.create-body'); if (b.scrollHeight > b.clientHeight) throw new Error(`the creation step scrolls: ${b.scrollHeight} in ${b.clientHeight}`);" }
    ]
  },
  {
    "name": "rich",
    "helper": true,
    "steps": [
      { "include": "setup" },
      { "eval": "const s = JSON.parse(localStorage.getItem('brute.save')); const c = s.character; c.level = 10; c.xp = 9; c.weapons = ['bat', 'chain', 'traffic_sign']; c.pets = ['dog']; c.gear = ['riot_vest', 'sneakers']; c.skills = ['combo', 'iron_skin', 'spark']; c.cards = ['special', 'rage', 'weather_wave', 'patch_up', 'hurl', 'rush', 'haymaker']; c.cardUses = { special: 4, rage: 9, patch_up: 26, hurl: 1 }; delete c.deck; localStorage.setItem('brute.save', JSON.stringify(s)); location.reload();" },
      { "wait": 1500 }
    ]
  },
  {
    "name": "title",
    "steps": [
      { "save": null },
      { "shot": "title" }
    ]
  },
  {
    "name": "create-look",
    "steps": [
      { "save": null },
      { "click": "text=Start" },
      { "include": "no-page-scroll" },
      { "include": "no-step-scroll" },
      { "shot": "create-look" }
    ]
  },
  {
    "name": "create-class",
    "steps": [
      { "save": null },
      { "click": "text=Start" },
      { "click": ".create-next" },
      { "click": ".carousel-card:nth-child(3)" },
      { "include": "no-page-scroll" },
      { "include": "no-step-scroll" },
      { "shot": "create-class" }
    ]
  },
  {
    "name": "create-origin",
    "steps": [
      { "save": null },
      { "click": "text=Start" },
      { "click": ".create-next" },
      { "click": ".create-next" },
      { "click": ".create-panel .choice-grid .choice:nth-child(2)" },
      { "include": "no-page-scroll" },
      { "include": "no-step-scroll" },
      { "shot": "create-origin" },
      { "click": ".create-panel .choice-grid .choice:nth-child(6)" },
      { "include": "no-step-scroll" },
      { "shot": "create-origin-scrapyard" },
      { "click": ".create-panel .choice-grid .choice:nth-child(3)" },
      { "include": "no-step-scroll" },
      { "shot": "create-origin-metro" },
      { "click": ".create-panel .choice-grid .choice:nth-child(1)" },
      { "include": "no-step-scroll" },
      { "shot": "create-origin-port" },
      { "click": ".create-panel .choice-grid .choice:nth-child(4)" },
      { "include": "no-step-scroll" },
      { "click": ".create-panel .choice-grid .choice:nth-child(5)" },
      { "include": "no-step-scroll" }
    ]
  },
  {
    "name": "create-name",
    "steps": [
      { "save": null },
      { "click": "text=Start" },
      { "click": ".create-next" },
      { "click": ".create-next" },
      { "click": ".create-next" },
      { "include": "no-page-scroll" },
      { "include": "no-step-scroll" },
      { "shot": "create-name" },
      { "eval": "const input = document.querySelector('.name-input'); input.value = 'Miquel'; input.dispatchEvent(new Event('input'));" },
      { "shot": "create-name-typed" }
    ]
  },
  {
    "name": "tab-fight",
    "steps": [
      { "include": "level-10" },
      { "include": "no-page-scroll" },
      { "shot": "tab-fight" }
    ]
  },
  {
    "name": "tab-fight-levelup",
    "steps": [
      { "include": "setup" },
      { "eval": "const s = JSON.parse(localStorage.getItem('brute.save')); s.character.level = 5; s.pendingLevelUps = 1; s.offer = null; localStorage.setItem('brute.save', JSON.stringify(s)); location.reload();" },
      { "wait": 1500 },
      { "include": "no-page-scroll" },
      { "shot": "tab-fight-levelup" },
      { "click": ".fight-go" },
      { "shot": "tab-fight-levelup-offer" }
    ]
  },
  {
    "name": "tab-fighter-new",
    "steps": [
      { "include": "setup" },
      { "click": ".tab-fighter" },
      { "include": "no-page-scroll" },
      { "shot": "tab-fighter-new" }
    ]
  },
  {
    "name": "tab-fighter",
    "steps": [
      { "include": "rich" },
      { "click": ".tab-fighter" },
      { "include": "no-page-scroll" },
      { "shot": "tab-fighter" },
      { "click": ".inv-item" },
      { "shot": "tab-fighter-note" },
      { "eval": "document.querySelector('.shell-body').scrollTop = 9999;" },
      { "shot": "tab-fighter-bottom" }
    ]
  },
  {
    "name": "tab-cards",
    "steps": [
      { "include": "rich" },
      { "click": ".tab-cards" },
      { "include": "no-page-scroll" },
      { "shot": "tab-cards" },
      { "click": ".card-grid .game-card:nth-child(2)" },
      { "shot": "tab-cards-picked" },
      { "click": "text=Put in deck" },
      { "shot": "tab-cards-swapping" },
      { "click": ".deck-tray .game-card:nth-child(2)" },
      { "shot": "tab-cards-swapped" }
    ]
  },
  {
    "name": "levelup",
    "steps": [
      { "include": "setup" },
      { "eval": "const s = JSON.parse(localStorage.getItem('brute.save')); s.character.level = 5; s.pendingLevelUps = 1; s.offer = ['card:patch_up', 'card:hurl', 'card:rush']; localStorage.setItem('brute.save', JSON.stringify(s)); location.reload();" },
      { "wait": 1500 },
      { "shot": "levelup" }
    ]
  },
  {
    "name": "prefight",
    "steps": [
      { "include": "level-10" },
      { "click": ".fight-go" },
      { "shot": "prefight" }
    ]
  },
  {
    "name": "fight",
    "steps": [
      { "include": "level-10" },
      { "click": ".fight-go" },
      { "click": "text=Start fight" },
      { "wait": 6000 },
      { "shot": "fight" }
    ]
  }
]
